{
  "dialogue_contract": {
    "required_speakers": [
      "ずんだもん",
      "四国めたん"
    ],
    "both_must_have_substantive_spoken_turns": true,
    "visible_listener_does_not_count_as_spoken_dialogue": true,
    "minimum_spoken_turns_per_speaker": 2,
    "voicevox_speaker_ids_must_be_distinct_and_recorded": true,
    "never_relabel_single_speaker_audio_as_two_speakers": true,
    "roles": {
      "ずんだもん": "要点を平易に説明する",
      "四国めたん": "視聴者の疑問を質問し、具体例や短い言い換えで理解を助ける"
    },
    "avoid_mechanical_sentence_by_sentence_alternation": true,
    "both_speakers_participate_in_main_sections": true
  },
  "visual_density_contract": {
    "applies_to": "ALL_EXPLANATORY_AND_NEWS_VIDEOS",
    "purpose": "Use many relevant photos, product captures, screenshots and explanatory diagrams, with official sources preferred when useful but not required for every image.",
    "visual_beats_per_main_section": {
      "minimum": 2,
      "target_range": [
        2,
        4
      ],
      "unit": "DISTINCT_RELEVANT_VISUAL_BEATS"
    },
    "qualifying_visuals": [
      "OFFICIAL_ANNOUNCEMENT_IMAGE",
      "OFFICIAL_PRODUCT_OR_INTERFACE_SCREENSHOT",
      "OFFICIAL_STATEMENT_OR_COMMENT_SCREENSHOT",
      "RIGHTS_CLEARED_RELEVANT_PHOTOGRAPH",
      "RIGHTS_CLEARED_PRODUCT_SCREENSHOT",
      "RIGHTS_CLEARED_RELEVANT_SCREENSHOT",
      "ORIGINAL_EXPLANATORY_DIAGRAM"
    ],
    "visual_sequence": {
      "prefer_a_new_relevant_image_or_visual_each_beat": true,
      "avoid_repeating_one_still_as_filler": true,
      "use_visuals_to_explain_the_current_narration": true,
      "reused_visual_must_remain_relevant_to_its_new_section": true,
      "keep_primary_evidence_centered_and_legible_in_landscape": true,
      "use_chapter_title_lineup_evidence_and_summary_scene_variety": true,
      "characters_must_not_obscure_primary_evidence": true
    },
    "speed_rules": {
      "check_official_visual_cache_first": true,
      "prefer_original_official_source_media_and_cropped_source_page_screenshots": true,
      "prepare_screenshots_by_cropping_to_the_media_region_only": true,
      "include_official_quotes_or_comments_only_when_relevant_and_attributed": true,
      "use_simple_native_text_card_only_when_no_official_or_cleared_visual_exists": true,
      "image_generation_for_video_disabled": true,
      "reuse_verified_assets_and_capture_each_source_once": true,
      "asset_research_is_limited_to_official_visuals_needed_for_required_coverage": false,
      "visual_count_does_not_trigger_routine_preview_or_review": true,
      "asset_research_is_limited_to_relevant_images_needed_for_coverage": true,
      "reuse_landscape_layout_without_redesign_per_video": true
    },
    "rights_and_factuality": {
      "external_assets_require_source_page_locator_and_license_or_public_domain_state": true,
      "visual_must_not_imply_an_unsupported_claim": true,
      "do_not_use_uncleared_or_unknown_cost_assets": true,
      "paid_or_freemium_image_video_generation_remains_blocked": true,
      "official_source_does_not_automatically_mean_public_domain_or_reuse_license": true
    },
    "priority": "RELEVANT_IMAGE_DENSITY_WITHIN_THE_EXISTING_ONE_PASS_SPEED_FIRST_DELIVERY",
    "minimum_is_per_main_section_not_whole_video": true,
    "text_only_cards_do_not_count_as_image_coverage": true,
    "official_images_are_preferred_not_exclusive": true,
    "insufficient_image_coverage_action": "ADD_RELEVANT_CLEARED_IMAGES_OR_DIAGRAMS; DO_NOT_SILENTLY_REPLACE_WITH_ALL_TEXT_CARDS"
  }
}
